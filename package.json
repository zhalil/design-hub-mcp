{
  "name": "design-hub-mcp",
  "version": "0.2.0",
  "description": "One MCP server for OpenDesign, huashu-design and UI UX Pro Max with a Superdesign-style live canvas preview",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "setup": "node cli/design-hub.js setup",
    "update": "node cli/design-hub.js update",
    "preview": "node cli/design-hub.js serve --open",
    "test": "node --test test/",
    "check:canvas": "node scripts/canvas-check.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "bin": {
    "design-hub": "cli/design-hub.js",
    "design-hub-mcp": "src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "cli",
    "skills",
    ".claude-plugin",
    "sources.json",
    "snapshot",
    "README.md"
  ],
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
