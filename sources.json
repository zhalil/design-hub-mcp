{
  "$comment": "Upstream repositories Design Hub pulls skills, rules, design systems and engines from. Add your own entries; 'ref' pins a tag/branch/commit. 'provides' maps catalog kinds to paths inside the repo.",
  "sources": [
    {
      "id": "open-design",
      "repo": "https://github.com/nexu-io/open-design.git",
      "ref": "main",
      "enabled": true,
      "license": "Apache-2.0 (some bundled templates MIT)",
      "$sparse": "design systems: only the files the catalog serves (their HTML previews are ~1500 pages). Pictures, audio, video and fonts are never checked out for any source.",
      "sparse": [
        "/design-systems/*/DESIGN*.md", "/design-systems/*/USAGE.md", "/design-systems/*/manifest.json",
        "/design-systems/*/tokens.css", "/design-systems/*/tailwind-v4.css", "/design-systems/*/design-tokens.json", "/design-systems/*/components.html",
        "design-templates", "skills", "craft", "/LICENSE*", "/NOTICE*", "!/design-templates/*/scripts/verify-output/"
      ],
      "provides": {
        "systems": ["design-systems"],
        "templates": ["design-templates"],
        "skills": ["skills"],
        "rules": ["craft"]
      }
    },
    {
      "id": "huashu-design",
      "repo": "https://github.com/alchaincyf/huashu-design.git",
      "ref": "master",
      "enabled": true,
      "license": "MIT",
      "$sparse": "style specimens, showcases and demos are sample output, not part of the skill",
      "sparse": ["/*", "!/assets/style-specimens/", "!/assets/showcases/", "!/demos/"],
      "provides": {
        "skills": ["."],
        "references": ["references", "references/modules"],
        "lint": "scripts/design_lint.py"
      }
    },
    {
      "id": "ui-ux-pro-max",
      "repo": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill.git",
      "ref": "main",
      "enabled": true,
      "license": "MIT",
      "sparse": ["src", ".claude", "/LICENSE*"],
      "provides": {
        "skills": [".claude/skills"],
        "styleEngine": "src/ui-ux-pro-max/scripts/search.py"
      }
    },
    {
      "id": "taste-skill",
      "repo": "https://github.com/Leonxlnx/taste-skill.git",
      "ref": "main",
      "enabled": true,
      "license": "MIT",
      "sparse": ["skills", "/LICENSE*"],
      "provides": {
        "skills": ["skills"]
      }
    },
    {
      "id": "impeccable",
      "repo": "https://github.com/pbakaus/impeccable.git",
      "ref": "main",
      "enabled": true,
      "license": "Apache-2.0",
      "$sparse": "the repo ships the same skill for a dozen agents plus a Rust CLI and test fixtures; only the plugin copy is kept",
      "sparse": ["plugin/skills/impeccable", "/LICENSE*", "/NOTICE*"],
      "provides": {
        "skills": ["plugin/skills"]
      }
    },
    {
      "id": "awesome-design-md",
      "repo": "https://github.com/VoltAgent/awesome-design-md.git",
      "ref": "main",
      "enabled": true,
      "license": "MIT",
      "sparse": ["/design-md/*/DESIGN.md", "/LICENSE*"],
      "provides": {
        "systems": ["design-md"]
      }
    },
    {
      "id": "anthropic-skills",
      "repo": "https://github.com/anthropics/skills.git",
      "ref": "main",
      "enabled": false,
      "license": "see repository",
      "sparse": ["skills/frontend-design"],
      "provides": {
        "skills": ["skills"]
      }
    }
  ]
}
